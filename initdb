DROP TABLE IF EXISTS messaggi;
DROP TABLE IF EXISTS partite;
DROP TABLE IF EXISTS users;


CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    nome VARCHAR(50) NOT NULL,
    cognome VARCHAR(50) NOT NULL,
    citta VARCHAR(100) DEFAULT NULL,
    bio TEXT DEFAULT NULL,
    livello ENUM('Base', 'Intermedio', 'Esperto') DEFAULT 'Base',
    creazione TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


CREATE TABLE messaggi (
    id INT AUTO_INCREMENT PRIMARY KEY,
    mittente_id INT NOT NULL,
    destinatario_id INT NOT NULL,
    messaggio TEXT NOT NULL,
    is_read TINYINT(1) DEFAULT 0,
    data_invio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (mittente_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (destinatario_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


CREATE TABLE partite (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT NOT NULL,
    outcome ENUM('vittoria', 'sconfitta') NOT NULL, 
    data_partita TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
